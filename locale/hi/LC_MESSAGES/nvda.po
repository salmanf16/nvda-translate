msgstr "NVDA भाषा से मिलान"

msgid "No compatible Gemini models found."
msgstr "कोई संगत जेमिनी मॉडल नहीं मिला."

msgid "No compatible OpenAI models found."
msgstr "कोई संगत OpenAI मॉडल नहीं मिला."

msgid "No focused application"
msgstr "कोई केंद्रित अनुप्रयोग नहीं"

msgid "No saved translations for {app}"
msgstr "{ऐप} के लिए कोई सहेजा गया अनुवाद नहीं"

msgid "No translation to copy"
msgstr "कॉपी करने के लिए कोई अनुवाद नहीं"

msgid "OpenAI &model:"
msgstr "ओपनएआई और मॉडल:"

msgid "OpenAI API &key:"
msgstr "ओपनएआई एपीआई और कुंजी:"

msgid "Please enter a Gemini API key first."
msgstr "कृपया पहले जेमिनी एपीआई कुंजी दर्ज करें।"

msgid "Please enter an OpenAI API key first."
msgstr "कृपया पहले एक OpenAI API कुंजी दर्ज करें।"

msgid "Press twice to delete all cached translations for all applications."
msgstr "सभी एप्लिकेशन के सभी कैश्ड अनुवादों को हटाने के लिए दो बार दबाएँ।"

msgid "Press twice to delete all translations for {app}"
msgstr "{ऐप} के सभी अनुवाद हटाने के लिए दो बार दबाएँ"

msgid "Remove all cached translations for all applications."
msgstr "सभी एप्लिकेशन के लिए सभी कैश्ड अनुवाद हटाएँ।"

msgid "Remove translation cache for the currently focused application"
msgstr "वर्तमान में केंद्रित एप्लिकेशन के लिए अनुवाद कैश हटाएं"

msgid "Some caches failed to be removed."
msgstr "कुछ कैश हटाए जाने में विफल रहे."

msgid "Success"
msgstr "सफलता"

msgid "Successfully fetched {count} Gemini models!"
msgstr "जेमिनी मॉडल सफलतापूर्वक लाए गए!"

msgid "Successfully fetched {count} OpenAI models!"
msgstr "{count} OpenAI मॉडल सफलतापूर्वक प्राप्त किए गए!"

msgid "Translate"
msgstr "अनुवाद"

msgid "Translation &engine:"
msgstr "अनुवाद &इंजन:"

msgid "Translation cache for {app} has been deleted."
msgstr "{ऐप} के लिए अनुवाद कैश हटा दिया गया है."

msgid "Translation disabled."
msgstr "अनुवाद अक्षम।"

msgid "Translation enabled."
msgstr "अनुवाद सक्षम।"

msgid "translation {text} ¨copied to clipboard"
msgstr "अनुवाद {पाठ} क्लिपबोर्ड पर कॉपी किया गया"


msgid "&Target language:"
msgstr "&लक्ष्य भाषा:"

msgid "All translations have been deleted."
msgstr "सभी अनुवाद हटा दिए गए हैं."

msgid "Copy the latest translated text to the clipboard."
msgstr "नवीनतम अनुवादित पाठ को क्लिपबोर्ड पर कॉपी करें।"

msgid "DeepL API &key:"

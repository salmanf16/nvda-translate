msgid "Enables translation to the desired language."
msgstr "वांछित भाषा में अनुवाद सक्षम बनाता है।"

msgid "Error"
msgstr "गलती"

msgid "Error while deleting application's translation cache."
msgstr "एप्लिकेशन का अनुवाद कैश हटाते समय त्रुटि."

msgid "Failed to fetch Gemini models: {error}"
msgstr "जेमिनी मॉडल लाने में विफल: {error}"

msgid "Failed to fetch OpenAI models: {error}"
msgstr "OpenAI मॉडल लाने में विफल: {त्रुटि}"

msgid "Fetch Gemini Models"
msgstr "जेमिनी मॉडल प्राप्त करें"

msgid "Fetch OpenAI Models"
msgstr "OpenAI मॉडल प्राप्त करें"

msgid "Fetching..."
msgstr "लाया जा रहा है..."

msgid "Gemini &model:"
msgstr "Gemini और मॉडल:"

msgid "Gemini API &key:"
msgstr "जेमिनी एपीआई और कुंजी:"

msgid "Info"
msgstr "जानकारी"

msgid "LibreTranslate &URL:"
msgstr "लिबरट्रांसलेट और यूआरएल:"

msgid "LibreTranslate API &key (optional):"
msgstr "लिब्रेट्रांसलेट एपीआई और कुंजी (वैकल्पिक):"

